# Copy to .env.local for dev, or set as real secrets in your deployment platform.
# Never commit an actual .env / .env.local file — see docs/engineering/security.md.

# Neo4j connection (local Docker default shown; swap for AuraDB URI in prod)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session/auth secret — used to sign session tokens carrying userId + isSupervisor.
# Generate with: openssl rand -base64 32
SESSION_SECRET=changeme

# File attachments (Fact evidence — PDFs, imaging). One bucket/dir, not a subsystem.
# Local dev can point this at a folder; prod should point at a single S3/MinIO bucket.
ATTACHMENTS_STORAGE_PATH=./storage

#Cloudinary Credentials to store File attachements
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=